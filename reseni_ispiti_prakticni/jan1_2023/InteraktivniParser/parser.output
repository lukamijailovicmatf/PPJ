Grammar

    0 $accept: program $end

    1 program: program naredba ';'
    2        | naredba ';'

    3 naredba: SIFRA_T ID_T
    4        | SIFRA_T ID_T '(' izraz ',' drugi_arg ')'
    5        | SIFRA_T ID_T '=' izraz
    6        | STAMPAJ_T izraz
    7        | LISTA_SIFRI_T ID_T '=' izraz
    8        | izraz

    9 drugi_arg: izraz
   10          | '?'

   11 izraz: INT_T
   12      | REAL_T
   13      | ID_T
   14      | izraz '+' izraz
   15      | izraz '-' izraz
   16      | izraz '*' izraz
   17      | izraz '/' izraz
   18      | '-' izraz
   19      | izraz '.' FST_T
