Grammar

    0 $accept: program $end

    1 program: program naredba
    2        | naredba

    3 naredba: LIST_T '<' tip_podataka '>' ID_T ';'
    4        | LIST_T '<' tip_podataka '>' ID_T '=' izraz ';'
    5        | ID_T '=' izraz ';'
    6        | izraz ';'

    7 tip_podataka: NUMBER_TYPE_T
    8             | STRING_TYPE_T

    9 izraz: ID_T
   10      | '{' lista_elemenata '}'
   11      | izraz '+' izraz
   12      | izraz '-' izraz
   13      | izraz '*' izraz
   14      | '-' izraz
   15      | izraz '<' izraz
   16      | izraz '>' izraz
   17      | izraz LEQ_T izraz
   18      | izraz GEQ_T izraz
   19      | izraz EQ_T izraz
   20      | izraz NEQ_T izraz
   21      | '(' izraz ')'
   22      | izraz '.' PRINT_T '(' ')'
   23      | izraz '.' PRINT_R_T '(' ')'
   24      | izraz '.' PUSH_BACK_T '(' vrednost ')'
   25      | izraz '.' PUSH_FRONT_T '(' vrednost ')'
   26      | izraz '.' PUSH_T '(' vrednost ',' BROJ_T ')'
   27      | izraz '.' POP_BACK_T '(' ')'
   28      | izraz '.' POP_FRONT_T '(' ')'
   29      | izraz '.' POP_T '(' BROJ_T ')'
   30      | izraz '.' FIND_T '(' vrednost ')'
   31      | izraz '.' GET_T '(' BROJ_T ')'

   32 lista_elemenata: lista_elemenata ',' BROJ_T
   33                | lista_elemenata ',' STRING_T
   34                | BROJ_T
   35                | STRING_T

   36 vrednost: BROJ_T
   37         | STRING_T
   38         | ID_T


